FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends tor wget ca-certificates iproute2 \
 && rm -rf /var/lib/apt/lists/*
COPY chutney/run.sh /usr/local/bin/chutney-run
RUN chmod +x /usr/local/bin/chutney-run
EXPOSE 5000 5001 5002 7000
ENTRYPOINT ["/usr/local/bin/chutney-run"]
